# KG Laundry Environment Configuration

# Database: Uses local SQLite by default, or PostgreSQL / Supabase when DATABASE_URI is provided
# DATABASE_URI=postgresql://postgres:password@localhost:5432/kglaundry
DATABASE_URI=file:./kglaundry.db

# Payload CMS Secret Key
PAYLOAD_SECRET=your_payload_secret_key_here

# Base URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Obfuscated Admin Panel Route (defaults to /admin)
NEXT_PUBLIC_ADMIN_ROUTE=/admin

# AI Providers (Google Gemini or OpenAI)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_AI_PROVIDER=gemini

# App Store Links
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/kg-laundry/id123456789
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.kglaundry.app
NEXT_PUBLIC_WHATSAPP_NUMBER=+919876543210

# Security
CRON_SECRET=your_cron_secret_token_here

# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
